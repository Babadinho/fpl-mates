# fpl-mates configuration
#
# Copy to .env.local and fill in the two required values. Everything else has a
# working default — a missing optional variable turns a feature off, it never
# breaks the poller.
#
#   cp .env.example .env.local

# =============================================================================
# Required
# =============================================================================

# Your mini-league ID. Open the league on the FPL site and read it from the URL:
#   https://fantasy.premierleague.com/leagues/123456/standings/c
FPL_LEAGUE_ID=

# Any Postgres connection string. On Neon, use the POOLED one (host contains
# "-pooler") — serverless functions open many short-lived connections.
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# =============================================================================
# Database (optional)
# =============================================================================

# Direct, non-pooled connection. Used only by `pnpm db:migrate`, which needs a
# session-level connection and will fail over a pooler. Defaults to DATABASE_URL.
# DATABASE_URL_UNPOOLED=postgresql://user:password@host/dbname?sslmode=require

# =============================================================================
# Identity and copy
# =============================================================================

# Overrides the league name FPL returns. Leave unset to use the real one.
# LEAGUE_DISPLAY_NAME=The Sunday League

# Shown next to the eyebrow. Leave unset to derive it from gameweek deadlines.
# SEASON_LABEL=2026/27

# The small uppercase line above the league name.
# SITE_EYEBROW=Fantasy Premier League

# =============================================================================
# Scoring rules
#
# These are group decisions, not ours. Whatever is set here is stated in the
# footnote under every table, so nobody has to read the source to know how
# they lost.
# =============================================================================

# Drives deadline display and, critically, which month a gameweek belongs to.
# TIMEZONE=Europe/London

# Applied in order until the tie breaks; a tie surviving all of them is declared
# shared. Must start with "points". Valid keys: points, hits, bench, overall_rank.
#   points       the higher score, after transfer costs
#   hits         fewer points lost to transfers
#   bench        fewer points left on the bench
#   overall_rank the better overall FPL rank at that point in the season
#
# Scores always come from FPL's own `event_transfers_cost`, so banked free
# transfers (up to five) and Wildcard / Free Hit weeks are already handled —
# this project never works the deduction out for itself.
# TIEBREAK_ORDER=points,hits,bench,overall_rank

# Do gameweeks played BEFORE a manager joined the league count toward the
# weekly and monthly tables? Default false — they only score from the gameweek
# they joined.
# COUNT_PREJOIN_GWS=false

# =============================================================================
# Theme
#
# Mapped straight onto the CSS variables. Any valid CSS colour works.
# =============================================================================

# ACCENT_COLOR=oklch(0.42 0.17 305)
# POP_COLOR=oklch(0.72 0.19 145)
# ACCENT_COLOR_DARK=oklch(0.72 0.19 145)
# POP_COLOR_DARK=oklch(0.78 0.16 100)

# Show the "points left on bench" column in tables.
# SHOW_BENCH_COLUMN=true

# =============================================================================
# Poller
# =============================================================================

# Identify yourself to the FPL API. Please change the contact URL if you fork.
# FPL_USER_AGENT=fpl-mates/0.1.0 (+https://github.com/you/your-fork)

# Override only for testing against a mock server.
# FPL_BASE_URL=https://fantasy.premierleague.com/api

# Parallel entry-history requests. Raise cautiously for large leagues; the API
# has no published rate limit but will throttle aggressive clients.
# POLL_CONCURRENCY=4

# bootstrap-static is ~1.4MB and near-static. Cache it hard.
# BOOTSTRAP_CACHE_HOURS=24

# If set, /api/poll requires `Authorization: Bearer <secret>`. Strongly
# recommended on a public deployment. Vercel Cron sends this automatically.
# CRON_SECRET=

# =============================================================================
# WhatsApp publisher (optional — leave unset for web only)
#
# Official Meta WhatsApp Cloud API only. Do NOT use Baileys, green-api or
# similar unofficial libraries; they get the number banned.
# =============================================================================

# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_ACCESS_TOKEN=
# WHATSAPP_RECIPIENT=
# WHATSAPP_VERIFY_TOKEN=

# ---- Design review ------------------------------------------------------
# Render the checked-in mock league instead of Postgres. Useful for working on
# the design before the season starts, or for running with no database at all.
# USE_FIXTURES=0
