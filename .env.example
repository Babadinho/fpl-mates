# fpl-mates configuration
#
# Copy to .env.local and fill in the two required values. Everything else has a
# working default — a missing optional variable turns a feature off, it never
# breaks the poller.
#
#   cp .env.example .env.local
#
# Every value below is the DEFAULT. Uncomment and change to override.
# Boolean settings take true or false (1/0, yes/no and on/off also work).

# =============================================================================
# Required
# =============================================================================

# Your mini-league ID. Open the league on the FPL site and read it from the URL:
#   https://fantasy.premierleague.com/leagues/123456/standings/c
FPL_LEAGUE_ID=

# Any Postgres connection string. On Neon, use the POOLED one (host contains
# "-pooler") — serverless functions open many short-lived connections.
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# =============================================================================
# Database (optional)
# =============================================================================

# Direct, non-pooled connection. Used only by `pnpm db:migrate`, which needs a
# session-level connection and will fail over a pooler. Defaults to DATABASE_URL.
# DATABASE_URL_UNPOOLED=postgresql://user:password@host/dbname?sslmode=require

# =============================================================================
# Identity and copy
# =============================================================================

# Overrides the league name FPL returns. Leave unset to use the real one.
# LEAGUE_DISPLAY_NAME=The Sunday League

# Shown next to the eyebrow. Leave unset to derive it from gameweek deadlines.
# SEASON_LABEL=2026/27

# The small uppercase line above the league name.
# SITE_EYEBROW=Fantasy Premier League

# Your public address, used to make the share-preview image URL absolute and to
# identify this deployment to the FPL API. Defaults to the domain Vercel
# injects, so set it only if you have a custom domain — without it, link
# previews point at your-app.vercel.app instead.
# SITE_URL=https://your-league.example.com

# =============================================================================
# Scoring rules
#
# These are group decisions, not ours. Whatever is set here is stated in the
# footnote under every table, so nobody has to read the source to know how
# they lost.
# =============================================================================

# Drives deadline display and, critically, which month a gameweek belongs to.
# TIMEZONE=Europe/London

# Applied in order until the tie breaks; a tie surviving all of them is declared
# shared. Must start with "points". Valid keys: points, hits, bench, overall_rank.
#   points       the higher score, after transfer costs
#   hits         fewer points lost to transfers
#   bench        fewer points left on the bench
#   overall_rank the better overall FPL rank at that point in the season
#
# Scores always come from FPL's own `event_transfers_cost`, so banked free
# transfers (up to five) and Wildcard / Free Hit weeks are already handled —
# this project never works the deduction out for itself.
# TIEBREAK_ORDER=points,hits,bench,overall_rank

# Do gameweeks played BEFORE a manager joined the league count toward the
# weekly and monthly tables? Default false — they only score from the gameweek
# they joined. Set true to count everything.
# COUNT_PREJOIN_GWS=false

# =============================================================================
# Theme
#
# Mapped straight onto the CSS variables. Any valid CSS colour works.
# =============================================================================

# ACCENT_COLOR=oklch(0.42 0.17 305)
# POP_COLOR=oklch(0.72 0.19 145)
# ACCENT_COLOR_DARK=oklch(0.72 0.19 145)
# POP_COLOR_DARK=oklch(0.78 0.16 100)

# Show the "points left on bench" column in tables. Set false to hide it.
# SHOW_BENCH_COLUMN=true

# Search box above the table. Tables paginate at 25 rows.
#   auto   (default) shown only when the league is larger than one page
#   true   always shown
#   false  never shown
# A small league has nothing to search, hence the default.
# SHOW_SEARCH=auto

# =============================================================================
# Poller
# =============================================================================

# Identify yourself to the FPL API (gotcha 3). Defaults to naming this
# deployment — fpl-mates/0.1.0 (+https://your-site) — using SITE_URL, so a fork's
# traffic points at the fork and not at the upstream repository. Set this only
# if you want something else, such as a contact address.
# FPL_USER_AGENT=fpl-mates/0.1.0 (+mailto:you@example.com)

# Seconds to share one live/fixtures fetch across visitors (0-300). Without it,
# ten people opening the page at once costs twenty upstream requests for the
# same data. 0 disables sharing.
# LIVE_CACHE_SECONDS=30

# Override only for testing against a mock server.
# FPL_BASE_URL=https://fantasy.premierleague.com/api

# Parallel entry-history requests. Raise cautiously for large leagues; the API
# has no published rate limit but will throttle aggressive clients.
# POLL_CONCURRENCY=4

# bootstrap-static is ~1.4MB and near-static. Cache it hard.
# BOOTSTRAP_CACHE_HOURS=24

# If set, /api/poll requires `Authorization: Bearer <secret>`. Strongly
# recommended on a public deployment. Vercel Cron sends this automatically.
# CRON_SECRET=

# NOTE: the poll SCHEDULE is not an environment variable. Vercel reads
# vercel.json at deploy time and does not interpolate env vars into it, so edit
# the cron expression there. It ships as "17 * * * *" — hourly, at 17 minutes
# past, deliberately not on the hour so that self-hosted instances do not all
# hit the FPL API at the same moment (section 11, item 1). If you fork this,
# please change 17 to some other minute.
#
# Vercel's Hobby plan REJECTS any cron running more than once a day, so
# vercel.json ships a daily schedule and .github/workflows/poll.yml calls the
# same endpoint hourly for free. That workflow needs two repository secrets:
#   POLL_URL     https://<your-app>.vercel.app/api/poll
#   CRON_SECRET  the same value you set in Vercel

# ---- Live scoring --------------------------------------------------------

# Provisional scores and the fixtures grid while a gameweek is in play. Costs
# two extra API requests per page load. Set false to disable.
# LIVE_SCORING=true

# Re-fetch live scores on a timer. The refresh button is the intended way; a
# timer means every open tab keeps polling whether anyone is watching or not.
# Set true to enable.
# LIVE_AUTO_REFRESH=false

# Interval for LIVE_AUTO_REFRESH, in seconds (15-600). Ignored when it is off.
# LIVE_REFRESH_SECONDS=60

# =============================================================================
# WhatsApp publisher (optional — leave unset for web only)
#
# Official Meta WhatsApp Cloud API only. Do NOT use Baileys, green-api or
# similar unofficial libraries; they get the number banned.
# =============================================================================

# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_ACCESS_TOKEN=
# WHATSAPP_RECIPIENT=
# WHATSAPP_VERIFY_TOKEN=

# ---- Design review ------------------------------------------------------
# Render the checked-in mock league instead of Postgres. Useful for working on
# the design before the season starts, or for running with no database at all.
# Set true to enable — never in production, or the site shows the demo league.
# USE_FIXTURES=false

# Let search engines index the site. Off by default — a mini-league table is
# a private thing among friends. The page sends noindex; robots.txt still
# allows crawling, because a crawler that is blocked never sees the noindex
# (and link previews would break). Set true to allow indexing.
# ALLOW_INDEXING=false

# ---- Privacy ------------------------------------------------------------

# Shared passcode for the whole league. Unset means the page is public.
# Not accounts: one code everybody uses, remembered on their device for 90
# days. Changing it (or CRON_SECRET) signs everybody out.
# LEAGUE_PASSCODE=

# How long a device stays unlocked after entering the passcode (1-400).
# The gate footnote is generated from this, so it always tells the truth.
# PASSCODE_REMEMBER_DAYS=90

